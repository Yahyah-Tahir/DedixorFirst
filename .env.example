# ===========================================
# Dedixor Portfolio - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values
# cp .env.example .env.local

# -----------------------------------------
# DATABASE - Neon PostgreSQL (Required)
# -----------------------------------------
# Get your connection string from: https://console.neon.tech
# Format: postgresql://username:password@ep-xxx-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# -----------------------------------------
# AUTHENTICATION (Required)
# -----------------------------------------
# Secret key for signing admin session cookies
# Generate with: openssl rand -base64 32
# Must be at least 32 characters long
ADMIN_SESSION_SECRET=

# -----------------------------------------
# SITE CONFIGURATION (Optional)
# -----------------------------------------
# Your site's public URL (used for metadata and API calls)
# Development: http://localhost:3000
# Production: https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
